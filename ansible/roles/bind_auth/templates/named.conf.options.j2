// {{ ansible_managed }}
options {
    directory "{{ bind_directory }}";
{% for line in bind_platform_options %}
    {{ line }}
{% endfor %}

    // Listen on all interfaces
    listen-on port 53 { any; };
    listen-on-v6 port 53 { any; };

    // Disable recursion - this is authoritative only
    recursion no;
    allow-recursion { none; };

    // Allow queries from anyone (public authoritative server)
    allow-query { any; };

    // Disable zone transfers by default (override per-zone)
    allow-transfer { none; };

    // DNSSEC
    dnssec-validation auto;

    // Security hardening
    version "not disclosed";
    minimal-responses yes;

    // Rate limiting
    rate-limit {
        responses-per-second {{ bind_auth_rrl_responses_per_second }};
        window {{ bind_auth_rrl_window }};
    };
};
